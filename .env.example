# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave "publishable" (o anon). Es pública: la seguridad la dan RLS y las funciones SQL.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Opcional: 1 = la web pública usa un catálogo de ejemplo en memoria (sin base de datos).
# Sirve para ver el diseño sin Supabase. El panel /admin sigue necesitando Supabase.
# ELMATE_DEMO=1

# Opcional: 1 = muestra en el panel las funciones de la segunda etapa (ventas, caja e ingresos).
# Están desarrolladas pero ocultas hasta la entrega final del proyecto.
# NEXT_PUBLIC_ELMATE_ETAPA2=1
